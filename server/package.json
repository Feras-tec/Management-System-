{
  "name": "react-business-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "postinstall": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "test:integration:db": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run test/*.integration.test.ts",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@clerk/fastify": "^3.1.64",
    "@fastify/cors": "^11.3.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
