generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum VehicleType {
  SEDAN
  SUV
  HATCHBACK
  VAN
  COUPE
  WAGON
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum SaleItemType {
  PRODUCT
  SERVICE
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum InventoryMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  DAMAGE
  CANCELLATION
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  email     String?
  phone     String?
  address   String?
  currency  String   @default("EUR")
  locale    String   @default("de")
  timezone  String   @default("Europe/Berlin")
  taxRateBps Int     @default(1900)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  services  Service[]
  customers Customer[]
  vehicles  Vehicle[]
  bookings  Booking[]
  products Product[]
  inventoryMovements InventoryMovement[]
  sales Sale[]
  payments Payment[]
  employees Employee[]
  openingHours BusinessOpeningHour[]
}

model BusinessOpeningHour {
  businessId String
  dayOfWeek  DayOfWeek
  isOpen     Boolean @default(false)
  openTime   String?
  closeTime  String?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([businessId, dayOfWeek])
}

model User {
  id          String   @id @default(cuid())
  clerkUserId String   @unique
  businessId String
  role        UserRole @default(EMPLOYEE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inventoryMovements InventoryMovement[]
  createdSales Sale[] @relation("SaleCreatedBy")
  createdPayments Payment[] @relation("PaymentCreatedBy")
  employee Employee?

  @@index([businessId])
  @@unique([id, businessId])
}

model Service {
  id                 String   @id @default(cuid())
  businessId         String
  slug               String
  nameDe             String
  nameEn             String
  shortDescriptionDe String
  shortDescriptionEn String
  descriptionDe      String
  descriptionEn      String
  priceFrom          Int
  durationMinutes    Int
  imageUrl            String?
  isActive           Boolean  @default(true)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings Booking[]
  saleItems SaleItem[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, isActive, sortOrder])
}


model Customer {
  id         String   @id @default(cuid())
  businessId String
  firstName  String
  lastName   String
  email      String
  phone      String
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicles Vehicle[]
  bookings Booking[]
  sales Sale[]

  @@unique([businessId, email, phone])
  @@index([businessId])
  @@index([businessId, lastName, firstName])
}

model Vehicle {
  id           String      @id @default(cuid())
  businessId   String
  customerId   String
  type         VehicleType
  brand        String?
  model        String?
  year         Int?
  licensePlate String?
  color        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings Booking[]

  @@index([businessId])
  @@index([customerId])
}

model Booking {
  id            String        @id @default(cuid())
  businessId    String
  bookingNumber String        @unique
  customerId    String
  vehicleId     String
  serviceId     String
  status        BookingStatus @default(PENDING)
  startsAt      DateTime
  endsAt        DateTime
  notes         String?
  internalNotes String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sales Sale[]

  @@index([businessId, startsAt])
  @@index([businessId, status])
  @@index([businessId, serviceId, startsAt])
  @@index([customerId])
  @@index([vehicleId])
}

model Product {
  id             String   @id @default(cuid())
  businessId     String
  sku            String
  name           String
  description    String?
  category       String?
  imageUrl       String?
  specifications Json?
  salePriceMinor Int
  costPriceMinor Int?
  stockQuantity  Int      @default(0)
  minimumStock   Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  inventoryMovements InventoryMovement[]
  saleItems SaleItem[]

  @@unique([businessId, sku])
  @@index([businessId, isActive])
  @@index([businessId, category])
  @@index([businessId, stockQuantity, minimumStock])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  businessId      String
  productId       String
  type            InventoryMovementType
  quantityDelta   Int
  quantityBefore  Int
  quantityAfter   Int
  reason          String?
  referenceType   String?
  referenceId     String?
  createdByUserId String?
  createdAt       DateTime              @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser User? @relation(fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([businessId, createdAt])
  @@index([productId, createdAt])
  @@index([createdByUserId])
}

model Sale {
 id String @id @default(cuid())
 businessId String
 saleNumber String
 customerId String?
 bookingId String?
 status SaleStatus @default(DRAFT)
 currency String @default("EUR")
 subtotalMinor Int
 discountMinor Int @default(0)
 taxMinor Int
 totalMinor Int
 createdByUserId String
 soldAt DateTime?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 business Business @relation(fields:[businessId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 customer Customer? @relation(fields:[customerId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 booking Booking? @relation(fields:[bookingId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 createdByUser User @relation("SaleCreatedBy",fields:[createdByUserId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 items SaleItem[]
 payments Payment[]
 @@unique([businessId,saleNumber])
 @@index([businessId,createdAt])
 @@index([businessId,status,soldAt])
 @@index([customerId])
 @@index([bookingId])
}
model SaleItem {
 id String @id @default(cuid())
 saleId String
 type SaleItemType
 productId String?
 serviceId String?
 description String
 quantity Int
 unitPriceMinor Int
 lineTotalMinor Int
 createdAt DateTime @default(now())
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 product Product? @relation(fields:[productId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 service Service? @relation(fields:[serviceId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 @@index([saleId])
 @@index([productId])
 @@index([serviceId])
}
model Payment {
 id String @id @default(cuid())
 businessId String
 saleId String
 method PaymentMethod
 status PaymentStatus @default(COMPLETED)
 amountMinor Int
 reference String?
 paidAt DateTime?
 createdByUserId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 business Business @relation(fields:[businessId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 sale Sale @relation(fields:[saleId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 createdByUser User @relation("PaymentCreatedBy",fields:[createdByUserId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 @@index([businessId,createdAt])
 @@index([saleId,status])
 @@index([createdByUserId])
}

model Employee {
 id String @id @default(cuid())
 businessId String
 userId String? @unique
 employeeNumber String
 firstName String
 lastName String
 email String?
 phone String?
 position String
 salaryMinor Int?
 status EmployeeStatus @default(ACTIVE)
 hiredAt DateTime?
 notes String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 business Business @relation(fields:[businessId],references:[id],onDelete:Restrict,onUpdate:Cascade)
 user User? @relation(fields:[userId,businessId],references:[id,businessId],onDelete:Restrict,onUpdate:Cascade)
 @@unique([businessId,employeeNumber])
 @@unique([userId,businessId])
 @@index([businessId,status])
 @@index([businessId,position])
 @@index([businessId,lastName,firstName])
}
